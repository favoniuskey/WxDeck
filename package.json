{
  "name": "wxdeck",
  "productName": "WxDeck",
  "version": "0.1.2",
  "description": "Professional weather and ATIS dashboard for IVAO virtual ATCs",
  "author": {
    "name": "Keywan D (FavoniusKey)",
    "email": "keywan.dupil@stelisys.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "pack": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run build && electron-builder --win --x64 --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "dseg": "^0.46.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
